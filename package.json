{
  "name": "avtoservis-landing",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "test:ui": "playwright test",
    "test:auth": "playwright test --config playwright.auth.config.js",
    "dev:telegram": "vite --host 0.0.0.0 --mode telegram",
    "build:telegram": "vite build --mode telegram",
    "test:telegram": "playwright test --config playwright.telegram.config.js",
    "bot:serve": "node --env-file-if-exists=.env.server.local server/telegram/index.js",
    "bot:check": "node --env-file-if-exists=.env.server.local scripts/configure-telegram-bot.js --check",
    "bot:configure": "node --env-file-if-exists=.env.server.local scripts/configure-telegram-bot.js --configure"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/roboto-condensed": "^5.3.0",
    "@supabase/supabase-js": "^2.119.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.4",
    "@vitejs/plugin-react": "^4.7.0",
    "tailwindcss": "^4.3.4",
    "vite": "^7.1.12"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
