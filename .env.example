# preview: UI fixtures. telegram: Mini App foundation. live: legacy phone Auth.
VITE_APP_MODE=preview
# Public browser configuration. Obtain from your project's Connect dialog.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Enable only after phone confirmation and SMS delivery are configured/tested.
VITE_PHONE_AUTH_ENABLED=false
# Never place a service-role key, SMS credential, or other server secret here.
# Store those only in the server / Supabase Edge Function secret settings.

# Public username only, without a token. Telegram build uses .env.telegram.
VITE_TELEGRAM_BOT_USERNAME=
