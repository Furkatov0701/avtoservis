# Copy to the repository root as .env.server.local (ignored by Git).
# Backend only. Never prefix these secrets with VITE_.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=urgutservis_bot
# Exact deployed HTTPS Mini App URL, including /app/ if applicable.
TELEGRAM_MINI_APP_URL=
# Exact deployed server URL ending in /telegram/webhook.
TELEGRAM_WEBHOOK_URL=
PORT=8787
